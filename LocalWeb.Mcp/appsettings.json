{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "LocalWeb": {
    "SearxngUrl": "http://127.0.0.1:8080",
    "CachePath": "cache.db",
    "SearchTtlMinutes": 180,
    "FetchTtlMinutes": 720,
    "ErrorTtlMinutes": 2,
    "MaxResponseBytes": 5000000,
    "MaxOutputChars": 20000,
    "HttpTimeoutSeconds": 20,
    "BrowserTimeoutSeconds": 30,
    "MaxRedirects": 5,
    "MaxConcurrentBrowserPages": 2,
    "AllowedSchemes": ["http", "https"],
    "AllowedPorts": [80, 443],
    "UserAgent": "LocalWebMcp/1.0",
    "DefaultMaxResults": 8,
    "MaxMaxResults": 20,
    "MinExtractCharsForBrowser": 400
  }
}
