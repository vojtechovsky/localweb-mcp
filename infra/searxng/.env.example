# Copy this file to .env and fill in the secret before running `docker compose up -d`.
#
#   cp .env.example .env
#   openssl rand -hex 32        # paste the output into SEARXNG_SECRET below
#
# .env is gitignored. Never commit a real secret.
#
# Docs: https://docs.searxng.org/admin/installation-docker.html

# Use a specific version tag. E.g. "latest" or "2026.3.25-541c6c3cb".
SEARXNG_VERSION=latest

# Bind the published port to loopback only. This keeps the instance local.
SEARXNG_HOST=127.0.0.1

# Listen to a specific port.
SEARXNG_PORT=8080

# Shared secret. Must match server.secret_key in core-config/settings.yml.
# Generate one with: openssl rand -hex 32
SEARXNG_SECRET=change-me-run-openssl-rand-hex-32
